// ====================================================================
// 3D NONLINEAR MAGNETOSTATICS - MERGED & BULLETPROOF
// Solves: Volume Maxwell Stress, Under-Relaxation, & Full Diagnostics
// ====================================================================
load "msh3"
load "medit"

macro print(x) cout << x << endl //

// Set to true to enable step-by-step 3D visual popups
bool enablePlot = true; 
macro medith(title, ThMesh, solField) if (enablePlot) { medit(title, ThMesh, solField); } //

// Smart Region Macros (Catches both Gmsh Volume IDs and Physical Tags)
macro isTopMag(t) (t == 102 || t == 2) //
macro isBtmMag(t) (t == 101 || t == 3) //
macro isAir(t)    (t == 103 || t == 4) //
macro isMagnet(t) (isTopMag(t) || isBtmMag(t)) //

// --------------------------------------------------------------------
// STEP 1: MESH LOADING & REGION DIAGNOSTICS
// --------------------------------------------------------------------
print("--- STEP 1: Loading & Verifying Mesh ---");
mesh3 ThRaw = readmesh3("alnico.mesh");
mesh3 Th = movemesh3(ThRaw, transfo=[x*1e-3, y*1e-3, z*1e-3]);

fespace Vh0(Th, P0);
Vh0 reg = region;

int totalElements = Th.nt;
int countTop = 0, countBtm = 0, countAir = 0;

for(int k=0; k<totalElements; k++) {
    if (isTopMag(reg[][k])) countTop++;
    else if (isBtmMag(reg[][k])) countBtm++;
    else if (isAir(reg[][k])) countAir++;
}

print("Total mesh elements: " << totalElements);
print(" -> Top Magnet Elements   : " << countTop);
print(" -> Bottom Magnet Elements: " << countBtm);
print(" -> Air/Gap Elements      : " << countAir);

Vh0 visReg = isTopMag(reg) ? 1 : (isBtmMag(reg) ? 2 : 3);
medith("1_Mesh_Regions", Th, visReg);

// --------------------------------------------------------------------
// STEP 2: PHYSICS PARAMETERS & BH CURVE
// --------------------------------------------------------------------
print("--- STEP 2: Setting up Initial Conditions ---");
real mu0 = 4.0 * pi * 1.0e-7;

real[int] Hdata = [-60000, -59000, -57500, -56000, -54000, -52000, -49000, -45000, -38000, -30000, -20000, -10000, 0];
real[int] Jdata = [0.0,    0.074,  0.305,  0.570,  0.800,  0.965,  1.100,  1.207,  1.285,  1.318,  1.338,  1.346,  1.35];
int nData = Hdata.n;
real Brbase = Jdata[nData-1]; 

// Initialize permeability and magnetization
Vh0 mu = mu0;
Vh0 BrZ = isMagnet(reg) ? Brbase : 0.0;

medith("2_Initial_Remanence_BrZ", Th, BrZ);

// --------------------------------------------------------------------
// STEP 3: NONLINEAR PICARD SOLVER WITH UNDER-RELAXATION
// --------------------------------------------------------------------
print("--- STEP 3: Starting Nonlinear Picard Iterations ---");
fespace Vh(Th, P2);
Vh Omega, v;

macro grad(u) [dx(u), dy(u), dz(u)] //
macro Hmag(u) sqrt(dx(u)^2 + dy(u)^2 + dz(u)^2 + 1e-12) //

problem MagStat(Omega, v, solver=CG) = 
    int3d(Th)( mu * (grad(Omega)' * grad(v)) )
  - int3d(Th)( BrZ * dz(v) )
  + on(201, Omega=0);

int maxIter = 100; // Increased to allow deep demagnetization
real relax = 0.25; // Under-relaxation shock absorber

for(int i=0; i<maxIter; i++) {
    MagStat;
    
    // if (i % 5 == 0) medith("3_Scalar_Potential_Iter_" + i, Th, Omega);
    
    Vh0 currentH = Hmag(Omega); 
    real sumH = 0.0;
    
    for (int k = 0; k < Th.nt; k++) {
        if (isMagnet(reg[][k])) {
            real Hval = -abs(currentH[][k]); // Quadrant 2
            sumH += Hval;
            real Bval = 0.0;
            
            // Interpolate B-H Curve
            if (Hval <= Hdata[0]) Bval = mu0 * Hval + Jdata[0];
            else if (Hval >= Hdata[nData-1]) Bval = mu0 * Hval + Jdata[nData-1];
            else {
                for (int j = 0; j < nData-1; j++) {
                    if (Hval >= Hdata[j] && Hval <= Hdata[j+1]) {
                        real slope = (Jdata[j+1] - Jdata[j]) / (Hdata[j+1] - Hdata[j]);
                        Bval = mu0 * Hval + (Jdata[j] + slope * (Hval - Hdata[j]));
                        break;
                    }
                }
            }
            
            // Calculate secant slope robustly
            real mucalc = (abs(Hval) < 1e-3) ? (mu0 + 4.0e-7) : abs((Bval - Brbase) / Hval);
            
            // Apply under-relaxation to prevent bouncing on the curve knee
            mu[][k] = (i == 0) ? mucalc : (relax * mucalc + (1.0 - relax) * mu[][k]);
            
        } else {
            mu[][k] = mu0; // Air remains air
        }
    }
    
    real avgH = sumH / (countTop + countBtm + 1e-6);
    print("  -> Iteration " << i+1 << " | Avg H-field in magnets: " << avgH << " A/m");
}

// --------------------------------------------------------------------
// STEP 4: FORCE CALCULATION (VOLUME MAXWELL STRESS)
// --------------------------------------------------------------------
print("--- STEP 4: Calculating Attractive Force ---");

// Calculate actual B-field components
fespace VhP1(Th, P1);
VhP1 Bx = -mu * dx(Omega);
VhP1 By = -mu * dy(Omega);
VhP1 Bz = -mu * dz(Omega) + BrZ;

// Analytical derivative of virtual displacement (non-zero ONLY in the gap)
// We use 0.0999 to safely avoid floating point ambiguity at element boundaries
func dzShiftZ = (z > -0.0999e-3 && z < 0.0999e-3) ? (1.0 / 0.2e-3) : 0.0;

// Integrate the tensile stress strictly across the air gap
real Fz = int3d(Th)( 
    (1.0/mu0 * Bz^2 - 0.5/mu0 * (Bx^2 + By^2 + Bz^2)) * dzShiftZ 
);

print("=====================================================");
print("  ACTUAL NONLINEAR ATTRACTION FORCE: " << abs(Fz) << " Newtons");
print("=====================================================");

// --------------------------------------------------------------------
// STEP 5: FINAL VISUALIZATIONS
// --------------------------------------------------------------------
print("--- STEP 5: Rendering Final Visuals ---");
mesh3 ThSlice = trunc(Th, y <= 0);
fespace VhSlice(ThSlice, P1dc);
VhSlice BnormSlice = sqrt((-mu*dx(Omega))^2 + (-mu*dy(Omega))^2 + (-mu*dz(Omega) + BrZ)^2);

print("          SIMULATION COMPLETE                        ");
medith("4_Final_Sliced_B_Field_Density", ThSlice, BnormSlice);